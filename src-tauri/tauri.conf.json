{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FolderMind",
  "version": "0.2.0",
  "identifier": "com.gabrielsantos.foldermind",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "FolderMind",
        "width": 1300,
        "height": 800,
        "minWidth": 1300,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
